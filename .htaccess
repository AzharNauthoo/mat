
RewriteEngine On
RewriteBase /

#0) One address for the whole site: https://www.mauritiusairport-transfers.com
#   Sends http:// and the non-www domain there in a single 301, keeping the path.
#   Must stay first: rule 2 below ends processing on LiteSpeed, so a host rule
#   placed after it never runs for inner pages.
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\.mauritiusairport-transfers\.com$ [NC]
RewriteRule ^ https://www.mauritiusairport-transfers.com%{REQUEST_URI} [L,R=301]

#1) redirect file.html to file
RewriteCond %{THE_REQUEST} /([^.]+).html [NC]
RewriteRule .+ /%1 [L,R=301]
#2) rewrite /file to file.html
 RewriteCond %{REQUEST_FILENAME}.html -f
 RewriteRule (.*)/?$ /$1.html [L]

Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
